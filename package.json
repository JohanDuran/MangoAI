{
  "name": "mangoai",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "mango": "tsx packages/core/src/cli.ts",
    "start": "npm start -w @mangoai/server",
    "claude-setup": "tsx packages/mcp/src/install.ts",
    "mcp": "tsx packages/mcp/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}

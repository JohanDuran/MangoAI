  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/JohanDuran/MangoAI",
  "repository": { "type": "git", "url": "git+https://github.com/JohanDuran/MangoAI.git", "directory": "packages/cli" },
  "keywords": ["video", "editor", "mcp", "claude", "hyperframes", "video-studio"],
  "bin": { "mangoai": "dist/bin.js" },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=22" },

# Copy this file to .env and fill in your own key.
# Used for Whisper transcription and image generation (both call OpenAI's API directly).
OPENAI_API_KEY=

# Optional: point image generation at an OpenAI-compatible server (default: https://api.openai.com/v1).
# OPENAI_BASE_URL=

# Optional: extra folders of skills (";" separated on Windows, ":" elsewhere). External skills run
# code on your machine and are never enabled automatically; see docs/writing-skills.md.
# MANGOAI_SKILLS_DIRS=

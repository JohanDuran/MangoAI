import React from 'react';
import { interpolate, spring, useCurrentFrame, useVideoConfig } from 'remotion';

interface Props {
  regionWidth?: number;
  regionHeight?: number;
}

export default function __EXPORT_NAME__({ regionWidth = 1920, regionHeight = 1080 }: Props) {
  const frame = useCurrentFrame();
  const { fps } = useVideoConfig();
  const enter = spring({ frame, fps, config: { damping: 200 } });
  const opacity = interpolate(enter, [0, 1], [0, 1]);

  return (
    <div
      style={{
        position: 'absolute',
        left: regionWidth * 0.06,
        bottom: regionHeight * 0.15,
        opacity,
        color: 'white',
        fontFamily: 'Inter, Helvetica, Arial, sans-serif',
        fontSize: Math.max(18, regionWidth * 0.025),
        fontWeight: 600,
      }}
    >
      __PROMPT__
    </div>
  );
}
